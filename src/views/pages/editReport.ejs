<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Report - Bug Report App</title>
  <!-- Bootstrap 5 CSS CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

  <!-- Header / Navbar -->
  <%- include('../partials/header') %>

  <!-- Main Content -->
  <main class="container my-5 flex-grow-1">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm border-0 rounded-3">
          <div class="card-body p-4 p-md-5">
            <h2 class="fw-bold mb-4 text-dark">Edit Report</h2>

            <form action="/reports/update/<%= report._id %>" method="POST">
              <!-- Title -->
              <div class="mb-3">
                <label for="title" class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                <input 
                  type="text" 
                  class="form-control" 
                  id="title" 
                  name="title" 
                  value="<%= report.title %>" 
                  placeholder="Enter bug title" 
                  required
                >
              </div>

              <!-- Project -->
              <div class="mb-3">
                <label for="project" class="form-label fw-semibold">Project</label>
                <input 
                  type="text" 
                  class="form-control" 
                  id="project" 
                  name="project" 
                  value="<%= report.project || '' %>" 
                  placeholder="e.g. Bug Report Management"
                >
              </div>

              <!-- Severity & Status Row -->
              <div class="row mb-3">
                <div class="col-md-6 mb-3 mb-md-0">
                  <label for="severity" class="form-label fw-semibold">Severity</label>
                  <select name="severity" id="severity" class="form-select">
                    <option value="low" <%= report.severity === 'low' ? 'selected' : '' %>>low</option>
                    <option value="medium" <%= report.severity === 'medium' ? 'selected' : '' %>>medium</option>
                    <option value="high" <%= report.severity === 'high' ? 'selected' : '' %>>high</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label for="status" class="form-label fw-semibold">Status</label>
                  <select name="status" id="status" class="form-select">
                    <option value="open" <%= report.status === 'open' ? 'selected' : '' %>>open</option>
                    <option value="in-progress" <%= report.status === 'in-progress' ? 'selected' : '' %>>in-progress</option>
                    <option value="resolved" <%= report.status === 'resolved' ? 'selected' : '' %>>resolved</option>
                    <option value="closed" <%= report.status === 'closed' ? 'selected' : '' %>>closed</option>
                  </select>
                </div>
              </div>

              <!-- Assigned To Dropdown -->
              <div class="mb-3">
                <label for="assignedTo" class="form-label fw-semibold">Assigned To <span class="text-danger">*</span></label>
                <select name="assignedTo" id="assignedTo" class="form-select" required>
                  <option value="" disabled>-- Select a user --</option>
                  <% if (typeof users !== 'undefined' && users && users.length > 0) { %>
                    <% users.forEach(user => { %>
                      <% 
                        const assignedId = report.assignedTo ? (report.assignedTo._id ? report.assignedTo._id.toString() : report.assignedTo.toString()) : '';
                        const isSelected = assignedId === user._id.toString();
                      %>
                      <option value="<%= user._id %>" <%= isSelected ? 'selected' : '' %>>
                        <%= user.name %> (<%= user.email %>)
                      </option>
                    <% }) %>
                  <% } else { %>
                    <option value="" disabled>No users available</option>
                  <% } %>
                </select>
              </div>

              <!-- Description -->
              <div class="mb-4">
                <label for="description" class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
                <textarea 
                  class="form-control" 
                  id="description" 
                  name="description" 
                  rows="4" 
                  placeholder="Describe the bug details and steps to reproduce..." 
                  required
                ><%= report.description %></textarea>
              </div>

              <!-- Action Buttons -->
              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">Update Report</button>
                <a href="/reports" class="btn btn-outline-secondary">Cancel</a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <%- include('../partials/footer') %>

  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
